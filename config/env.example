# Per-venue secrets template — copy to clients/<slug>/env (chmod 600) and fill in.
# NEVER commit the filled-in file.

# --- Identity ---------------------------------------------------------------
CLIENT_SLUG=venue_x
DISPLAY_NAME="Venue X"

# --- Mechanical safety gates (fail-closed) ----------------------------------
# The mirror only runs when BOTH are 1. Everything else defaults OFF.
MIRROR_ENABLED=0
DPA_SIGNED=0
# Local time window (HH:MM-HH:MM) during which a pull is allowed.
QUIET_WINDOW=01:00-06:00

# --- Read-only MySQL creds on the terminal (created by the runbook) ---------
MYSQL_HOST=192.0.2.10
MYSQL_PORT=3306
MYSQL_DB=optimumpos
MYSQL_USER=atlas_ro
MYSQL_PW=CHANGE_ME

# --- Twin database on the hub -----------------------------------------------
TWIN_MYSQL_HOST=127.0.0.1
TWIN_MYSQL_PORT=3306
TWIN_MYSQL_USER=root
TWIN_MYSQL_PW=CHANGE_ME

# --- Odoo target ------------------------------------------------------------
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=venue_x
ODOO_USER=admin
ODOO_PW=CHANGE_ME

# --- Off-site backup (restic + Backblaze B2), per tenant --------------------
RESTIC_REPOSITORY=b2:atlas-pos-backups:/venue_x
RESTIC_PASSWORD=CHANGE_ME
B2_ACCOUNT_ID=CHANGE_ME
B2_ACCOUNT_KEY=CHANGE_ME
