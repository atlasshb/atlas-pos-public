<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_pinvandaag_atlas" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.pos.pinvandaag.atlas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_payment_terminals_section" position="inside">
                <div class="col-12 col-lg-6 o_setting_box"
                    title="REST API v2 base URL. Empty = production. Point at a sandbox to test without a live terminal.">
                    <div class="o_setting_right_pane">
                        <label for="pinvandaag_base_url" string="Pin Vandaag API URL"/>
                        <div class="text-muted">
                            Override the Pin Vandaag REST API base URL (sandbox/testing)
                        </div>
                        <div class="content-group">
                            <field name="pinvandaag_base_url" placeholder="https://rest-api.pinvandaag.com/V2"/>
                        </div>
                    </div>
                </div>
            </block>
        </field>
    </record>
</odoo>
